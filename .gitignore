/target
# 本地与 CI doctest 专用的隔离目标目录
/target-doctest
/tools/zucchini-ab/target
/plugin/target
# 前端类型包：只提交构建产物（dist-js）与 lockfile，不提交 node_modules
/plugin/node_modules
/examples/tauri-app/src-tauri/target
/examples/tauri-app/src-tauri/Cargo.lock
/examples/tauri-app/src-tauri/gen
/mock_release
/test_env
/test_env_uac
/test_run
/real_test
/.update.lock
/update_failures.txt
*.log
*.patch
*.json
!Cargo.json
!package.json
# npm lockfile 必须入库（CI 用 `npm ci`）；上面的 *.json 规则会误伤
!/plugin/package-lock.json
!/plugin/tsconfig.json
# 插件权限 schema 由 build.rs 生成，发布包必须带它
!/plugin/permissions/schemas/schema.json
# 示例应用只需要两份手写的配置 JSON
!/examples/tauri-app/src-tauri/tauri.conf.json
!/examples/tauri-app/src-tauri/capabilities/default.json

# 导出脚本与其产物不入库；docs 下只有源码导出是产物，设计文档要进版本库
/scripts/
/docs/项目源码导出.md
/项目源码导出.md
# 内部草稿/评审稿不入库
/docs/深度评审报告-*.md
